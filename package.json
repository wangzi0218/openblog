{
  "name": "openblog",
  "version": "1.0.0",
  "description": "A modern WordPress blog theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangzi0218/openblog"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "css:dev": "yarn tailwindcss -i ./theme/css/tailwind.css -o ./theme/style.css --watch",
    "css:build": "yarn tailwindcss -i ./theme/css/tailwind.css -o ./theme/style.css --minify"
  },
  "keywords": [
    "wordpress",
    "theme",
    "blog"
  ],
  "author": "wannz",
  "license": "MIT",
  "dependencies": {
    "@astrojs/mdx": "2.1.1",
    "@astrojs/rss": "4.0.1",
    "@astrojs/sitemap": "3.2.1",
    "@astrojs/tailwind": "5.1.0",
    "@fontsource-variable/inter": "5.0.16",
    "@pagefind/default-ui": "1.3.0",
    "@tailwindcss/typography": "0.5.10",
    "astro": "4.2.1",
    "astro-font": "0.0.77",
    "motion": "10.17.0",
    "reading-time": "1.5.0",
    "tailwind-merge": "2.2.0",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "typescript": "5.3.3"
  }
}
